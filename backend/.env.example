# ── Application ──
SECRET_KEY=change-me-in-production
# 运行环境：development / production / test（生产必须配置 INTERNAL_API_TOKEN 与 SECRET_KEY）
ENV=development
# 内部 API 令牌：保护 /uploads、/reports 文件访问接口（Authorization: Bearer <token>）。
# 生产环境必填（否则启动失败）；nginx 反代 / 开发代理会自动附加该令牌。
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=

# ── Database (MySQL) ──
# 先创建数据库: CREATE DATABASE autopilot CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/autopilot

# ── AI ──
# 阿里云 DashScope（通义千问）OpenAI 兼容模式；也可换成 DeepSeek 等兼容接口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.5-flash
# AI 调用熔断：每分钟最多调用次数（防无底线烧 Token）
# 旧配置名 OPENAI_MAX_CALLS_PER_MIN 兼容；推荐统一使用 AI_RATE_LIMIT
AI_RATE_LIMIT=30
OPENAI_MAX_CALLS_PER_MIN=30
# AI 并发上限：同一时刻最多多少个 AI 请求在途（按实际 API 配额设置，如 3/5/10）
# 批量生成/自愈任务通过有界队列 + Semaphore 限制并发，不会 100 线程全量打 API
AI_MAX_CONCURRENCY=3

# ── 自愈 ──
# 同一步骤同类错误连续失败达到该次数后跳过自愈
HEAL_MAX_RETRY_SAME_ERROR=3
# 执行前目标环境健康检查（目标不可达时提前拦截）
PRE_EXECUTION_CHECK=true

# ── Playwright ──
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_HEADLESS=true
MAX_HEAL_RETRY=3

# ── SSRF 防护 ──
# 执行期除 target 同源外额外允许访问的 host（逗号分隔，支持子域后缀 .corp.internal）
# 项目级也可通过 config_json["allowed_hosts"] 配置
# SSRF_ALLOWED_HOSTS=
# 除 80/443 外允许访问的端口（逗号分隔，内网测试服务如 8080）
# 项目级也可通过 config_json["allowed_ports"] 配置
# SSRF_ALLOWED_PORTS=

# ── Storage ──
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
SCREENSHOT_DIR=./uploads/screenshots
VIDEO_DIR=./uploads/videos
EXCEL_DIR=./uploads/excels

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
