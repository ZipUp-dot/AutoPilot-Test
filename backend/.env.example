# ── Application ──
SECRET_KEY=change-me-in-production

# ── Database (MySQL) ──
# 先创建数据库: CREATE DATABASE autopilot CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/autopilot

# ── AI ──
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ── Playwright ──
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_HEADLESS=true
MAX_HEAL_RETRY=3

# ── Storage ──
UPLOAD_DIR=./uploads
REPORT_DIR=./reports
SCREENSHOT_DIR=./uploads/screenshots
VIDEO_DIR=./uploads/videos
EXCEL_DIR=./uploads/excels

# ── Server ──
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
